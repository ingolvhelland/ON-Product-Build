# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed - see .gitignore for why.

ANTHROPIC_API_KEY=

# onbuild.mailbox (PB-030) - the dedicated job-search Gmail account only.
# GMAIL_APP_PASSWORD is a 16-character App Password (Google Account >
# Security > 2-Step Verification > App passwords - requires 2-Step
# Verification to be enabled first), not the account's real login
# password. Scoped to this one account, independently revocable. Never
# paste the actual password anywhere but this file.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
